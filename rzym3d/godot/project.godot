; Roman Empire — od narodzin przez rozkwit aż po upadek (Kroniki Damiana Ścisła) — projekt Godot 4.3

config_version=5

[application]

config/name="Roman Empire — od narodzin przez rozkwit aż po upadek"
config/description="Edukacyjna strategia turowa 3D: starożytny Rzym 753 p.n.e. – 476 n.e."
run/main_scene="res://sceny/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.12, 0.07, 0.06, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=2
environment/ssao/quality=2
environment/ssao/half_size=true
environment/glow/upscale_mode=1
camera/depth_of_field/depth_of_field_bokeh_shape=2
camera/depth_of_field/depth_of_field_bokeh_quality=2

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_variable=0
gdscript/warnings/shadowed_variable=0
