; Jan Zamoyski i Miasto Idealne 3D — projekt Godot 4.3

config_version=5

[application]

config/name="Jan Zamoyski i Miasto Idealne 3D"
config/description="Edukacyjna gra strategiczna 3D: budowa renesansowego Zamościa (1580–1605)."
run/main_scene="res://sceny/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.14, 0.09, 0.07, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
